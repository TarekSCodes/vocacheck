{
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error"
  },
  "ignorePatterns": ["node_modules/", "coverage/"],
  "overrides": [
    {
      "files": ["**/__tests__/**/*.js"],
      "env": {
        "jest": true
      }
    },
    {
      "files": ["public/**/*.js"],
      "excludedFiles": ["public/__tests__/**/*.js"],
      "env": {
        "browser": true,
        "node": false
      },
      "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
      }
    },
    {
      "files": ["public/__tests__/**/*.js"],
      "env": {
        "jest": true,
        "browser": true,
        "node": true
      },
      "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
      }
    }
  ]
}
