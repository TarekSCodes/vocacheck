# ============================================
# Docker Environment Variables
# ============================================
# Lines starting with '#' are commented out and use default values.
# To override a default value, simply uncomment the line (remove '#') and change the value.
# Required API keys must be uncommented and filled with your actual keys.
# ============================================

#RESTART=unless-stopped

# --------------------------------------------
# Application Configuration
# --------------------------------------------
#APP_PORT=8080
#OLLAMA_URL=http://ollama:11434
#WHISPER_URL=http://whisper:9000
#NODE_ENV=production


# --------------------------------------------
# Ollama Configuration
# --------------------------------------------
#OLLAMA_PORT=11434


# --------------------------------------------
# Whisper Configuration
# --------------------------------------------
#WHISPER_PORT=9000
#ASR_MODEL=small
#ASR_ENGINE=faster_whisper